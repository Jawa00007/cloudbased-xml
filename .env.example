# Copy to .env and fill in values — NEVER commit .env to git

# ── Database (Supabase Session Pooler) ────────────────────────────────────────
# NOTE: password must be alphanumeric only (no special chars — breaks URL parsing)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
API_KEY=change-me-to-a-random-api-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local: * | Production: https://frontend-stg-707s-projects.vercel.app
ALLOWED_ORIGINS=*

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Data path ─────────────────────────────────────────────────────────────────
SII_DATA_PATH=data
