# Database — Supabase Session Pooler
# Format: postgresql+psycopg://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# NOTE: password must be alphanumeric only (no special chars)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Nextcloud (one set per account — added in Milestone 2)
# BAT_NEXTCLOUD_URL=https://...
# BAT_NEXTCLOUD_USER=...
# BAT_NEXTCLOUD_PASS=...

# VPN (WireGuard — required for Italian IP to reach Nextcloud)
# VPN_INTERFACE=wg0
# VPN_ENABLED=true

# API Auth
API_KEY=your-api-key-here                  # X-API-Key header for machine clients
ADMIN_USERNAME=admin                        # JWT login username
ADMIN_PASSWORD=your-admin-password-here    # JWT login password (alphanumeric recommended)

# Scheduler (set ENVIRONMENT=production to enable nightly job)
# ENVIRONMENT=production
