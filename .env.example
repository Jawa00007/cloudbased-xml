# Copy to .env and fill in values — NEVER commit .env to git

# ── Database (local PostgreSQL via Docker) ────────────────────────────────────
# Production (Docker Compose): db is the container name
DATABASE_URL=postgresql+psycopg://sii:sii_db_2024@db:5432/sii

# Local dev (port-forward or tunnel to DO server):
# DATABASE_URL=postgresql+psycopg://sii:sii_db_2024@localhost:5433/sii

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
API_KEY=change-me-to-a-random-api-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local: * | Production: https://frontend-stg-707s-projects.vercel.app
ALLOWED_ORIGINS=*

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Data path ─────────────────────────────────────────────────────────────────
SII_DATA_PATH=data
