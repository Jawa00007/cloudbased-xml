# Staging environment — copy to .env.staging on the server and fill in real values
# This file is committed to git. Never commit .env.staging itself.

# Database — points to sii_staging (separate from production sii database)
DATABASE_URL=postgresql+psycopg://sii:<db-password>@db:5432/sii_staging

# Data directory — shared with production (read-only access is fine for staging)
SII_DATA_PATH=/app/data

# App secrets — use different values from production
SECRET_KEY=<staging-secret-key>
API_KEY=<staging-api-key>

# Admin UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<staging-admin-password>

# CORS — open for staging (developer access from any origin)
ALLOWED_ORIGINS=*

# Environment identifier — controls /api/health response and log verbosity
ENVIRONMENT=staging
LOG_LEVEL=DEBUG
