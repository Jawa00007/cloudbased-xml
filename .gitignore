# Environment — never commit credentials
.env
.env.*
!.env.example
!.env.staging.example

# SSH deploy key (generated on server, never committed)
_deploy_key_private.txt

# Data files — client XML/ZIP files, can be large and sensitive
data/

# Generated reports — contain live client data
reports/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Node / frontend (when built)
node_modules/
frontend/dist/
frontend/dist-staging/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db
desktop.ini

# Alembic — don't commit auto-generated migration files without review
# database/migrations/versions/  ← uncomment if you want to exclude

# Logs
*.log

# Vercel
.vercel

# Claude Code local config and memory (personal, not project-shared)
.claude/

# Graphify knowledge graph output (regenerate with: graphify update .)
graphify-out/
